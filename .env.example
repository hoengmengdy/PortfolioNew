# Copy to .env.local for local development. Never commit real values.
# Every VITE_* value is compiled into the public JavaScript bundle, so only
# put public configuration here: never API keys, tokens or passwords.

# Production URL, without a trailing slash. Used for canonical links, Open Graph
# tags, sitemap.xml and robots.txt. If unset, the build falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL or Netlify's URL variable.
VITE_SITE_URL=
