SECRET_KEY=replace-with-a-long-random-secret
# Postgres (required on Vercel; set automatically by its Neon integration). Leave empty locally to use database.db.
DATABASE_URL=
# First admin account for hosted sites (created on start-up if missing; password at least 12 characters).
ADMIN_USERNAME=
ADMIN_PASSWORD=
COOKIE_SECURE=false
CONTACT_EMAIL=
CONTACT_PHONE=
# Shown in the footer when set, e.g. "Street 51, BKK1, Phnom Penh" and "Mon–Sat 8:00–18:00"
CONTACT_ADDRESS=
BUSINESS_HOURS=
INSTAGRAM_URL=
# Customer sign-in codes are sent to the customer's Telegram.
# Free: create a bot with @BotFather in Telegram and paste its token here.
TELEGRAM_BOT_TOKEN=
# Paid alternative (no bot step): token from https://gateway.telegram.org
TELEGRAM_GATEWAY_TOKEN=
# Local testing without a token: codes are printed to the server log. Never enable on a public site.
TELEGRAM_DEV_MODE=false
# ABA PayWay online payment (KHQR, ABA PAY, cards). Get sandbox keys at https://sandbox.payway.com.kh/register-sandbox/
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
# Sandbox: https://checkout-sandbox.payway.com.kh   Live: https://checkout.payway.com.kh
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_CURRENCY=USD
# Shop and payment
CURRENCY_SYMBOL=$
DELIVERY_FEE=1.50
# Leave PAYMENT_ACCOUNT_NUMBER empty to offer cash on delivery only.
PAYMENT_BANK_NAME=ABA Bank
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
# Use shared Redis storage when deploying multiple processes:
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
